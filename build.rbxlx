closeShelfButton.TextSize = 14
closeShelfButton.Parent = shelfPanel

local departmentHeader = Instance.new("TextLabel")
departmentHeader.Name = "DepartmentHeader"
departmentHeader.Size = UDim2.fromOffset(158, 20)
