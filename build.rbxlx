	wallX("ExtNorth", 0, -halfD, W, nil)
	wallZ("ExtWest", -halfW, 0, D, nil)
	wallZ("ExtEast", halfW, 0, D, nil)

	for _, segment in {
		{ name = "ExtSouthFarL", cx = -55, len = 10 },
