			color = Color3.fromRGB(215, 213, 210),
			material = Enum.Material.Brick,
		})
		storePart({
			name = `{window.name}_Sill`,
			size = Vector3.new(window.width, 2, wallT),
			position = Vector3.new(window.x, floorY + 1.5, halfD),
			color = Color3.fromRGB(215, 213, 210),
			material = Enum.Material.Brick,
		})
