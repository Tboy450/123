      <Item class="ModuleScript" referent="5">
        <Properties>
          <string name="Name">RetailCatalog</string>
          <string name="Source"><![CDATA[local RetailCatalog = {}

export type ProductDefinition = {
	name: string,
	color: Color3,
	material: Enum.Material,
	size: Vector3,
	priceCents: number,
}

export type DepartmentDefinition = {
	name: string,
	signColor: Color3,
	products: { ProductDefinition },
}

RetailCatalog.departments = {
	{
		name = "Produce",
		signColor = Color3.fromRGB(72, 112, 68),
		products = {
			{ name = "Apples", color = Color3.fromRGB(182, 56, 54), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.5, 1.3, 1.5), priceCents = 149 },
			{ name = "Bananas", color = Color3.fromRGB(225, 196, 72), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.9, 1.1, 1.3), priceCents = 129 },
			{ name = "Tomatoes", color = Color3.fromRGB(200, 72, 58), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.4, 1.2, 1.4), priceCents = 179 },
			{ name = "Lettuce", color = Color3.fromRGB(106, 154, 78), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.6, 1.3, 1.6), priceCents = 199 },
		},
	},
	{
		name = "Dairy",
		signColor = Color3.fromRGB(72, 92, 122),
		products = {
			{ name = "Milk", color = Color3.fromRGB(236, 238, 232), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.4, 2.1, 1.2), priceCents = 349 },
			{ name = "Yogurt", color = Color3.fromRGB(166, 202, 232), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.4, 1.3, 1.4), priceCents = 229 },
			{ name = "Cheese", color = Color3.fromRGB(235, 188, 70), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.8, 1.0, 1.4), priceCents = 449 },
			{ name = "Butter", color = Color3.fromRGB(244, 216, 118), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.8, 0.9, 1.2), priceCents = 299 },
		},
	},
	{
		name = "Frozen",
		signColor = Color3.fromRGB(62, 102, 126),
		products = {
			{ name = "Pizza", color = Color3.fromRGB(188, 92, 68), material = Enum.Material.SmoothPlastic, size = Vector3.new(2.2, 0.8, 1.6), priceCents = 699 },
			{ name = "Ice Cream", color = Color3.fromRGB(196, 220, 238), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.4, 1.8, 1.4), priceCents = 549 },
			{ name = "Vegetables", color = Color3.fromRGB(96, 154, 120), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.8, 1.1, 1.4), priceCents = 399 },
			{ name = "Meals", color = Color3.fromRGB(126, 144, 180), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.9, 0.9, 1.5), priceCents = 799 },
		},
	},
	{
		name = "Pantry",
		signColor = Color3.fromRGB(132, 92, 58),
		products = {
			{ name = "Cereal", color = Color3.fromRGB(210, 138, 72), material = Enum.Material.Cardboard, size = Vector3.new(1.6, 2.2, 1.0), priceCents = 449 },
			{ name = "Pasta", color = Color3.fromRGB(214, 188, 118), material = Enum.Material.Cardboard, size = Vector3.new(1.4, 1.9, 1.0), priceCents = 249 },
			{ name = "Soup", color = Color3.fromRGB(184, 90, 72), material = Enum.Material.Metal, size = Vector3.new(1.3, 1.4, 1.3), priceCents = 199 },
			{ name = "Snacks", color = Color3.fromRGB(172, 122, 84), material = Enum.Material.Cardboard, size = Vector3.new(1.8, 1.4, 1.1), priceCents = 379 },
		},
	},
	{
		name = "Household",
		signColor = Color3.fromRGB(92, 88, 112),
		products = {
			{ name = "Detergent", color = Color3.fromRGB(94, 146, 196), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.5, 2.2, 1.2), priceCents = 899 },
			{ name = "Paper Towels", color = Color3.fromRGB(230, 228, 220), material = Enum.Material.SmoothPlastic, size = Vector3.new(2.2, 1.7, 1.5), priceCents = 699 },
			{ name = "Soap", color = Color3.fromRGB(148, 198, 182), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.5, 1.2, 1.1), priceCents = 329 },
			{ name = "Cleaners", color = Color3.fromRGB(188, 210, 92), material = Enum.Material.SmoothPlastic, size = Vector3.new(1.4, 2.0, 1.0), priceCents = 579 },
		},
	},
}

local function wrapIndex(index: number, count: number): number
	return ((math.floor(index) - 1) % count) + 1
end

function RetailCatalog.wrapDepartmentIndex(index: number): number
	return wrapIndex(index, #RetailCatalog.departments)
end

function RetailCatalog.getDepartment(index: number): DepartmentDefinition
	return RetailCatalog.departments[RetailCatalog.wrapDepartmentIndex(index)]
end

function RetailCatalog.wrapProductIndex(departmentIndex: number, index: number): number
	local department = RetailCatalog.getDepartment(departmentIndex)
	return wrapIndex(index, #department.products)
end

function RetailCatalog.getProduct(departmentIndex: number, productIndex: number): ProductDefinition
	local department = RetailCatalog.getDepartment(departmentIndex)
	return department.products[RetailCatalog.wrapProductIndex(departmentIndex, productIndex)]
end

return RetailCatalog
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="6">
        <Properties>
          <string name="Name">RetailCurrency</string>
          <string name="Source"><![CDATA[local RetailCurrency = {}

export type Denomination = {
	name: string,
	cents: number,
	kind: "bill" | "coin",
	color: Color3,
}

RetailCurrency.denominations = {
	{ name = "$20", cents = 2000, kind = "bill", color = Color3.fromRGB(104, 156, 112) },
	{ name = "$10", cents = 1000, kind = "bill", color = Color3.fromRGB(92, 138, 102) },
	{ name = "$5", cents = 500, kind = "bill", color = Color3.fromRGB(84, 124, 94) },
	{ name = "$1", cents = 100, kind = "bill", color = Color3.fromRGB(74, 110, 84) },
	{ name = "25c", cents = 25, kind = "coin", color = Color3.fromRGB(180, 182, 184) },
	{ name = "10c", cents = 10, kind = "coin", color = Color3.fromRGB(168, 170, 174) },
	{ name = "5c", cents = 5, kind = "coin", color = Color3.fromRGB(146, 148, 152) },
	{ name = "1c", cents = 1, kind = "coin", color = Color3.fromRGB(170, 108, 74) },
}

function RetailCurrency.formatCents(cents: number): string
	local safeCents = math.max(0, math.floor(cents))
	local dollars = math.floor(safeCents / 100)
	local remainder = safeCents % 100
	return string.format("$%d.%02d", dollars, remainder)
end

return RetailCurrency
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="7">
        <Properties>
          <string name="Name">RetailStoreBlueprint</string>
          <string name="Source"><![CDATA[-- Symmetric retail supermarket greybox.
local RetailStoreBlueprint = {}
local RetailCatalog = require(script.Parent:WaitForChild("RetailCatalog"))

local DEFAULT_NAME = "RetailStore"
local BLUEPRINT_VERSION = 27

export type BuildOptions = {
	parent: Instance?,
	storeName: string?,
	forceRebuild: boolean?,
}

local SNAP = 2
local function snap(n: number): number
	return math.round(n / SNAP) * SNAP
end

local function snapHorizontalPosition(position: Vector3): Vector3
	return Vector3.new(snap(position.X), position.Y, snap(position.Z))
end

local function snapFootprint(size: Vector3): Vector3
	local x = if size.X >= SNAP then snap(size.X) else size.X
	local z = if size.Z >= SNAP then snap(size.Z) else size.Z
	return Vector3.new(math.max(x, 0.05), math.max(size.Y, 0.05), math.max(z, 0.05))
end

local function part(props: {
	name: string,
	size: Vector3,
	position: Vector3,
	color: Color3,
	material: Enum.Material?,
	transparency: number?,
	canCollide: boolean?,
	parent: Instance,
}): Part
	local p = Instance.new("Part")
	p.Name = props.name
	p.Size = props.size
	p.Position = props.position
	p.Anchored = true
	p.Color = props.color
	p.Material = props.material or Enum.Material.SmoothPlastic
	p.Transparency = props.transparency or 0
	p.Reflectance = 0
	p.CastShadow = true
	p.CanCollide = if props.canCollide == nil then true else props.canCollide
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.Parent = props.parent
	return p
end

function RetailStoreBlueprint.build(options: BuildOptions?): Model
	local parent = (options and options.parent) or workspace
	local storeName = (options and options.storeName) or DEFAULT_NAME
	local forceRebuild = if options and options.forceRebuild ~= nil then options.forceRebuild else true

	local existing = parent:FindFirstChild(storeName)
	if existing then
		if forceRebuild then
			existing:Destroy()
		else
			return existing :: Model
		end
	end

	for _, child in parent:GetChildren() do
		if child:IsA("BasePart") and (child.Name:find("MapHint") or child.Name:find("Rojo Synced")) then
			child:Destroy()
		end
	end

	local store = Instance.new("Model")
	store.Name = storeName
	store:SetAttribute("BlueprintVersion", BLUEPRINT_VERSION)
	store.Parent = parent

	-- Walk surface top is always floorY + 0.5 (1-stud-thick floors at floorY)
	local floorY = 0.5
	local walkTop = floorY + 0.5
	local wallH = 14
	local wallT = 1
	local W, D = 120, 100
	local halfW, halfD = W / 2, D / 2
	local wallCenterY = floorY + wallH / 2 + 0.5

	local function storePart(props: {
		name: string,
		size: Vector3,
		position: Vector3,
		color: Color3,
		material: Enum.Material?,
		transparency: number?,
		canCollide: boolean?,
		parent: Instance?,
	}): Part
		local pos = snapHorizontalPosition(props.position)
		local size = snapFootprint(props.size)
		return part({
			name = props.name,
			size = size,
			position = pos,
			color = props.color,
			material = props.material,
			transparency = props.transparency,
			canCollide = props.canCollide,
			parent = props.parent or store,
		})
	end

	local function decorFloor(name: string, size: Vector3, position: Vector3, color: Color3, parent: Instance?)
		return storePart({
			name = name,
			size = size,
			position = position,
			color = color,
			material = Enum.Material.SmoothPlastic,
			transparency = 0.35,
			canCollide = false,
			parent = parent,
		})
	end

	local function addSign(
		parent: Instance,
		name: string,
		cx: number,
		cy: number,
		cz: number,
		w: number,
		text: string,
		color: Color3
	): Part
		local sign = storePart({
			name = name,
			size = Vector3.new(w, 2.5, 0.35),
			position = Vector3.new(cx, cy, cz),
			color = color,
			parent = parent,
		})
		if sign then
			for _, face in { Enum.NormalId.Front, Enum.NormalId.Back } do
				local gui = Instance.new("SurfaceGui")
				gui.Face = face
				gui.LightInfluence = 0.2
				gui.SizingMode = Enum.SurfaceGuiSizingMode.PixelsPerStud
				gui.PixelsPerStud = 60
				gui.Parent = sign

				local label = Instance.new("TextLabel")
				label.Name = "Label"
				label.Size = UDim2.fromScale(1, 1)
				label.BackgroundTransparency = 1
				label.Text = text
				label.TextColor3 = Color3.fromRGB(245, 245, 245)
				label.TextScaled = true
				label.Font = Enum.Font.GothamBold
				label.Parent = gui
			end
		end

		return sign
	end

	local function addPrompt(target: BasePart, actionId: string, actionText: string, objectText: string, holdDuration: number?)
		target:SetAttribute("RetailAction", actionId)

		local prompt = Instance.new("ProximityPrompt")
		prompt.ActionText = actionText
		prompt.ObjectText = objectText
		prompt.HoldDuration = holdDuration or 0.15
		prompt.MaxActivationDistance = 10
		prompt.RequiresLineOfSight = false
		prompt.Parent = target
	end

	-- Wall along X axis (runs in X), placed at fixed Z
	local function wallX(
		name: string,
		xCenter: number,
		zFixed: number,
		lengthX: number,
		door: { offset: number, width: number }?,
		parentModel: Instance?
	)
		local y = wallCenterY
		if not door then
			storePart({
				name = name,
				size = Vector3.new(lengthX, wallH, wallT),
				position = Vector3.new(xCenter, y, zFixed),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
			return
		end

		local halfLen = lengthX / 2
		local doorStart = door.offset - door.width / 2
		local doorEnd = door.offset + door.width / 2
		local leftLen = (halfLen + doorStart)
		local rightLen = (halfLen - doorEnd)
		if leftLen > 0 then
			storePart({
				name = `{name}_L`,
				size = Vector3.new(leftLen, wallH, wallT),
				position = Vector3.new(xCenter - halfLen + leftLen / 2, y, zFixed),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
		end
		if rightLen > 0 then
			storePart({
				name = `{name}_R`,
				size = Vector3.new(rightLen, wallH, wallT),
				position = Vector3.new(xCenter + halfLen - rightLen / 2, y, zFixed),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
		end
	end

	-- Wall along Z axis (runs in Z), placed at fixed X
	local function wallZ(
		name: string,
		xFixed: number,
		zCenter: number,
		lengthZ: number,
		door: { offset: number, width: number }?,
		parentModel: Instance?
	)
		local y = wallCenterY
		if not door then
			storePart({
				name = name,
				size = Vector3.new(wallT, wallH, lengthZ),
				position = Vector3.new(xFixed, y, zCenter),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
			return
		end

		local halfLen = lengthZ / 2
		local doorStart = door.offset - door.width / 2
		local doorEnd = door.offset + door.width / 2
		local southLen = halfLen + doorStart
		local northLen = halfLen - doorEnd
		if southLen > 0 then
			storePart({
				name = `{name}_S`,
				size = Vector3.new(wallT, wallH, southLen),
				position = Vector3.new(xFixed, y, zCenter - halfLen + southLen / 2),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
		end
		if northLen > 0 then
			storePart({
				name = `{name}_N`,
				size = Vector3.new(wallT, wallH, northLen),
				position = Vector3.new(xFixed, y, zCenter + halfLen - northLen / 2),
				color = Color3.fromRGB(215, 213, 210),
				material = Enum.Material.Brick,
				parent = parentModel,
			})
		end
	end

	local function enclosedRoom(opts: {
		name: string,
		cx: number,
		cz: number,
		width: number,
		depth: number,
		floorColor: Color3,
		sign: string?,
		doorSide: "south" | "east" | "west" | "none"?,
	})
		local room = Instance.new("Model")
		room.Name = opts.name
		room.Parent = store

		local w, d = opts.width, opts.depth
		local cx, cz = opts.cx, opts.cz
		local floorOverlayH = 0.12

		storePart({
			name = "Floor",
			size = Vector3.new(w - 0.4, floorOverlayH, d - 0.4),
			position = Vector3.new(cx, walkTop + floorOverlayH / 2 + 0.015, cz),
			color = opts.floorColor,
			material = Enum.Material.Concrete,
			canCollide = false,
			parent = room,
		})

		storePart({
			name = "Ceiling",
			size = Vector3.new(w - 0.4, 0.35, d - 0.4),
			position = Vector3.new(cx, floorY + wallH - 0.35, cz),
			color = Color3.fromRGB(198, 198, 200),
			material = Enum.Material.SmoothPlastic,
			parent = room,
		})

		local northZ = cz - d / 2
		local southZ = cz + d / 2
		local westX = cx - w / 2
		local eastX = cx + w / 2

		wallX(`{opts.name}_N`, cx, northZ, w, nil, room)
		if opts.doorSide == "south" then
			wallX(`{opts.name}_S`, cx, southZ, w, { offset = 0, width = 8 }, room)
		else
			wallX(`{opts.name}_S`, cx, southZ, w, nil, room)
		end
		if opts.doorSide == "west" then
			wallZ(`{opts.name}_W`, westX, cz, d, { offset = 0, width = 6 }, room)
		else
			wallZ(`{opts.name}_W`, westX, cz, d, nil, room)
		end
		if opts.doorSide == "east" then
			wallZ(`{opts.name}_E`, eastX, cz, d, { offset = 0, width = 6 }, room)
		else
			wallZ(`{opts.name}_E`, eastX, cz, d, nil, room)
		end

		if opts.sign then
			addSign(room, "Sign", cx, floorY + 5, southZ + 0.8, math.min(w - 4, 12), opts.sign, Color3.fromRGB(65, 65, 70))
		end

		return room
	end

	local function walkFloor(name: string, size: Vector3, position: Vector3, color: Color3, material: Enum.Material, parent: Instance?)
		return storePart({
			name = name,
			size = Vector3.new(size.X, 1, size.Z),
			position = Vector3.new(position.X, floorY, position.Z),
			color = color,
			material = material,
			parent = parent,
		})
	end

	local function surfaceFloor(
		name: string,
		size: Vector3,
		position: Vector3,
		color: Color3,
		material: Enum.Material,
		parent: Instance?,
		topY: number
	)
		return storePart({
			name = name,
			size = Vector3.new(size.X, 1, size.Z),
			position = Vector3.new(position.X, topY - 0.5, position.Z),
			color = color,
			material = material,
			parent = parent,
		})
	end

	local function zoneMarker(name: string, cx: number, cz: number, w: number, d: number, color: Color3)
		-- Non-colliding overlay well above walk surface (prevents z-fight flicker when moving)
		decorFloor(`{name}Marker`, Vector3.new(w - 2, 0.05, d - 2), Vector3.new(cx, floorY + 0.68, cz), color)
	end

	local function addSoftLight(cx: number, cz: number, parent: Instance)
		local fixture = storePart({
			name = `Light_{cx}_{cz}`,
			size = Vector3.new(3, 0.3, 1),
			position = Vector3.new(cx, floorY + wallH - 0.5, cz),
			color = Color3.fromRGB(218, 216, 208),
			material = Enum.Material.SmoothPlastic,
			parent = parent,
		})
		local light = Instance.new("PointLight")
		light.Brightness = 0.5
		light.Range = 20
		light.Color = Color3.fromRGB(255, 244, 230)
		light.Parent = fixture
	end

	-- ========== MAIN SHELL (symmetric) ==========
	local entranceW = 20

	-- Floor chain with no gaps and no overlaps: interior → threshold → parking
	local interiorDepth = D - 6
	local floor = storePart({
		name = "MainFloor",
		size = Vector3.new(W, 1, interiorDepth),
		position = Vector3.new(0, floorY, -3),
		color = Color3.fromRGB(188, 188, 192),
		material = Enum.Material.Concrete,
	})

	walkFloor(
		"EntryThreshold",
		Vector3.new(entranceW + 6, 1, 10),
		Vector3.new(0, floorY, halfD - 1),
		Color3.fromRGB(178, 178, 182),
		Enum.Material.Concrete
	)

	storePart({
		name = "MainCeiling",
		size = Vector3.new(W, 1, D),
		position = Vector3.new(0, floorY + wallH, 0),
		color = Color3.fromRGB(202, 202, 204),
		material = Enum.Material.SmoothPlastic,
	})

	-- ========== ROOF SYSTEM ==========
	local roof = Instance.new("Model")
	roof.Name = "Roof"
	roof.Parent = store

	local roofY = floorY + wallH + 1
	local fasciaH = 2

	storePart({
		name = "RoofMain",
		size = Vector3.new(W + 2, 1, D + 2),
		position = Vector3.new(0, roofY, 0),
		color = Color3.fromRGB(72, 74, 78),
		material = Enum.Material.Metal,
		parent = roof,
	})

	-- Entrance canopy (covers door approach)
	storePart({
		name = "EntranceCanopy",
		size = Vector3.new(entranceW + 10, 0.8, 12),
		position = Vector3.new(0, roofY - 0.4, halfD + 2),
		color = Color3.fromRGB(88, 90, 94),
		material = Enum.Material.Metal,
		parent = roof,
	})
	storePart({
		name = "CanopyFrontLip",
		size = Vector3.new(entranceW + 12, 0.4, 1.2),
		position = Vector3.new(0, roofY - 0.7, halfD + 8),
		color = Color3.fromRGB(60, 62, 66),
		material = Enum.Material.Metal,
		parent = roof,
	})

	-- Fascia / parapet band
	local fasciaY = roofY + 0.9
	storePart({
		name = "FasciaNorth",
		size = Vector3.new(W + 2, fasciaH, 1),
		position = Vector3.new(0, fasciaY, -halfD - 0.5),
		color = Color3.fromRGB(55, 58, 62),
		material = Enum.Material.SmoothPlastic,
		parent = roof,
	})
	storePart({
		name = "FasciaSouth",
		size = Vector3.new(W + 2, fasciaH, 1),
		position = Vector3.new(0, fasciaY, halfD + 0.5),
		color = Color3.fromRGB(55, 58, 62),
		material = Enum.Material.SmoothPlastic,
		parent = roof,
	})
	storePart({
		name = "FasciaWest",
		size = Vector3.new(1, fasciaH, D + 2),
		position = Vector3.new(-halfW - 0.5, fasciaY, 0),
		color = Color3.fromRGB(55, 58, 62),
		material = Enum.Material.SmoothPlastic,
		parent = roof,
	})
	storePart({
		name = "FasciaEast",
		size = Vector3.new(1, fasciaH, D + 2),
		position = Vector3.new(halfW + 0.5, fasciaY, 0),
